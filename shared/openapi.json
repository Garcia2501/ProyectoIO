{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartFlow API",
    "description": "Backend de optimización de flujo de costo mínimo para SmartFlow. Modela una red vial como un grafo dirigido con capacidades y balances de oferta/demanda.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "description": "Comprobación de vida del servicio.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimize": {
      "post": {
        "summary": "Optimize Endpoint",
        "description": "Resuelve un escenario y devuelve la distribución de flujo óptima.\n\n- HTTP 200 con ``status`` \"optimal\" o \"infeasible\".\n- HTTP 422 cuando el payload no cumple el contrato (lo produce Pydantic).\n- HTTP 500 ante un error inesperado del solver (no se inventan datos).",
        "operationId": "optimize_endpoint_api_v1_optimize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Node": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "balance": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": -9007199254740991.0,
            "title": "Balance"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "x",
          "y",
          "balance"
        ],
        "title": "Node",
        "description": "Nodo de la red vial (zona)."
      },
      "OptimizeRequest": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "type": "array",
            "title": "Nodes"
          },
          "roads": {
            "items": {
              "$ref": "#/components/schemas/Road"
            },
            "type": "array",
            "title": "Roads"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "nodes",
          "roads"
        ],
        "title": "OptimizeRequest",
        "description": "Solicitud de optimización de un escenario."
      },
      "OptimizeResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "total_cost": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cost"
          },
          "total_supply": {
            "type": "integer",
            "title": "Total Supply"
          },
          "roads": {
            "items": {
              "$ref": "#/components/schemas/RoadResult"
            },
            "type": "array",
            "title": "Roads"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status",
          "scenario_name",
          "total_cost",
          "total_supply",
          "roads"
        ],
        "title": "OptimizeResponse",
        "description": "Respuesta del contrato REST."
      },
      "Road": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "capacity": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Capacity"
          },
          "unit_cost": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Unit Cost"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "capacity",
          "unit_cost"
        ],
        "title": "Road",
        "description": "Arco dirigido entre dos nodos. Una vía bidireccional son dos arcos."
      },
      "RoadResult": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "flow": {
            "type": "integer",
            "title": "Flow"
          },
          "capacity": {
            "type": "integer",
            "title": "Capacity"
          },
          "utilization_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Utilization Pct"
          }
        },
        "type": "object",
        "required": [
          "id",
          "flow",
          "capacity",
          "utilization_pct"
        ],
        "title": "RoadResult",
        "description": "Resultado por vía, en el mismo orden que la solicitud."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}